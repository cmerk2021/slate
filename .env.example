# Copy to .env and adjust. All variables are optional with sensible defaults.

# Public origin the app is served from (required for passkeys/WebAuthn in production)
APP_ORIGIN=http://localhost:3000
# WebAuthn relying-party ID — the bare hostname of APP_ORIGIN
RP_ID=localhost

# Secret used to derive the AES-256-GCM key that encrypts stored account passwords.
# Any long random string. If unset, a key file is auto-generated at /data/secret.key.
APP_SECRET=

# Session lifetime in days (sliding expiry)
SESSION_DAYS=30

# On-disk body/attachment cache cap in MB (LRU eviction)
CACHE_MAX_MB=2048

# debug | info | warn | error
LOG_LEVEL=info

# Set to 1 when running behind a reverse proxy so client IPs come from X-Forwarded-For
TRUST_PROXY=0

# Maximum attachment size for the composer, in MB
MAX_ATTACHMENT_MB=25
